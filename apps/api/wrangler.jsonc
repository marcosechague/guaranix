{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guaranix-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // 06:00 UTC is 03:00 in Asunción: classes for the next 2 weeks, before anyone books.
  "triggers": { "crons": ["0 6 * * *"] },
  // Payment receipts. Private: only the API reads them, after checking the box and role.
  "r2_buckets": [{ "binding": "RECEIPTS", "bucket_name": "guaranix-receipts" }],
  "vars": {
    "APP_ENV": "development",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:5174,http://localhost:5175",
    "PUBLIC_API_URL": "http://localhost:8787",
  },
  // Secrets never go here. Locally they live in `.dev.vars` (see `.dev.vars.example`);
  // in Cloudflare, `wrangler secret put AUTH_SECRET` and so on.
  // The Hyperdrive binding to Neon is added with the first deploy; until then
  // the Worker reads DATABASE_URL from `.dev.vars`.
}

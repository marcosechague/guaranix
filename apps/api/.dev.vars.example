# Copy to `.dev.vars` (git-ignored) for `wrangler dev`. Never put real production values here.

# Same database as the root .env: docker-compose publishes Postgres on POSTGRES_PORT (54329),
# not 5432, so it never collides with another Postgres already running on this machine.
DATABASE_URL=postgres://guaranix:guaranix@localhost:54329/guaranix

# `pnpm dev` already passes APP_ENV=development; keep it here if you run `wrangler dev` directly.
APP_ENV=development

# Any long random string locally. In Cloudflare it comes from the GitHub environment
# (docs/despliegue.md), made with `openssl rand -base64 48`. Changing it invalidates every password.
AUTH_SECRET=dev-only-secret-change-me-0123456789abcdefghijklmnop

# Optional in development. Leave them out and login works with email and
# password only: no captcha, no Google button, reset emails printed to the terminal.
# Cloudflare's Turnstile test keys (always pass) if you want to see the widget:
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# RESEND_API_KEY=
# EMAIL_FROM=GuaraniX <no-responder@tu-dominio>

# AI features (optional). 32 random bytes in base64 that encrypt the provider keys
# saved from the superadmin: `openssl rand -base64 32`. In Cloudflare:
# `wrangler secret put AI_SECRETS_KEY`. Without it AI features stay off.
# AI_SECRETS_KEY=

# Card payments (optional). Same format, a different key: it encrypts each box's
# processor private key (Bancard). In Cloudflare: `wrangler secret put PAYMENTS_SECRETS_KEY`.
# Without it boxes can't connect card payments. Locally, connect the "mock" provider
# from the box's payment settings to try the whole flow with no Bancard account.
# PAYMENTS_SECRETS_KEY=
# Notifications (optional, see docs/notificaciones.md). Without keys, Telegram and
# WhatsApp messages are printed to the terminal and push stays off.
# Push: `pnpm --filter @guaranix/messaging vapid:generate`. Cloudflare:
# In Cloudflare they come from the GitHub environment (docs/despliegue.md).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:soporte@guaranix.com.py
# Telegram bot from @BotFather; the webhook secret is any random string (`openssl rand -hex 32`).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=
# WhatsApp Cloud API (Meta): system user token and the sending number's "Phone number ID".
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

{
  "$schema": "../api/node_modules/wrangler/config-schema.json",
  // Static Worker that serves the Vite build. No code: Cloudflare answers from
  // the assets and falls back to index.html so client-side routes work.
  "name": "guaranix-member",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application" },
  // Hostnames must match deploy/environments.json (`pnpm check:deploy`).
  // workers.dev stays off: the session cookie only travels between subdomains
  // of the same site, so the app must be served from the real domain.
  "env": {
    "staging": {
      "workers_dev": false,
      "routes": [{ "pattern": "app-staging.guaranix.com.py", "custom_domain": true }],
    },
    "production": {
      "workers_dev": false,
      "routes": [{ "pattern": "app.guaranix.com.py", "custom_domain": true }],
    },
  },
}

{
  "$schema": "../api/node_modules/wrangler/config-schema.json",
  // The only public address: https://guaranix.<account>.workers.dev (or a custom
  // domain later). It serves the member app at `/`, the box panel at `/panel/`
  // and the platform at `/plataforma/`, and forwards `/api/*` to the API Worker.
  // One origin means one SameSite=Lax session cookie for all three apps, which
  // separate *.workers.dev hosts could not share (workers.dev is a public suffix).
  // The deploy assembles ./dist from the three Vite builds (docs/despliegue.md).
  "name": "guaranix",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "env": {
    "production": {
      "name": "guaranix",
      "workers_dev": true,
      "preview_urls": false,
      // Files are served straight from the asset store (no Worker run, no request
      // billed). The Worker only runs for /api/* and for paths with no file, which
      // are the apps' client-side routes.
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "none",
        "run_worker_first": ["/api/*"],
      },
      "services": [{ "binding": "API", "service": "guaranix-api-production" }],
    },
  },
}

{
  "name": "@guaranix/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema, migrations and seeds for Neon Postgres.",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:check": "node --env-file-if-exists=../../.env scripts/check-connection.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env scripts/seed.ts",
    "test": "vitest run",
    "db:bootstrap": "tsx --env-file-if-exists=../../.env scripts/bootstrap.ts"
  },
  "dependencies": {
    "@guaranix/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.1",
    "@types/node": "^26.6.11",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.2"
  }
}

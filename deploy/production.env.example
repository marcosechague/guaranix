# Copy to `.env.production` at the repo root (git-ignored, never commit it) to
# deploy from your own computer: `pnpm deploy:setup` once, then `pnpm deploy:production`.
# Same names as the `production` environment in GitHub (docs/despliegue.md), except
# the database: PROD_DATABASE_URL here, DATABASE_URL in GitHub.
# Keep the quotes: some values have spaces or symbols.

# Deploy
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
# Neon, direct (no -pooler), ending in ?sslmode=require. Not DATABASE_URL, so local
# tools never pick it up.
PROD_DATABASE_URL=""
# Printed by `pnpm deploy:setup`
HYPERDRIVE_ID=""
PLATFORM_ADMIN_EMAIL=""
# Only with a custom domain; empty uses https://guaranix.<subdomain>.workers.dev
PUBLIC_URL=""

# API, required
AUTH_SECRET=""
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
RESEND_API_KEY=""
EMAIL_FROM="GuaraniX <onboarding@resend.dev>"

# API, optional
PAYMENTS_SECRETS_KEY=""
AI_SECRETS_KEY=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
